{
  "expo": {
    "name": "Nexora AI",
    "slug": "Nexora-app-frontend",
    "owner": "atod-tech",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nexora",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atodtech.nexora",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.atodtech.nexora",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Nexora AI",
      "shortName": "Nexora",
      "description": "Your AI business assistant",
      "themeColor": "#1E56A0",
      "backgroundColor": "#FFFFFF",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nexora to access your photos to attach images.",
          "cameraPermission": "Allow Nexora to use your camera to attach photos.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-font",
      "expo-web-browser",
      "expo-build-properties",
      [
        "expo-notifications",
        {
          "color": "#1E56A0"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Nexora to use Face ID to unlock the app."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "206f9183-0f1f-4159-b787-2dcb1dc6e97f"
      }
    }
  }
}